{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/api/share?code=:code"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "talantul-in-negot.vercel.app"
        }
      ],
      "destination": "https://talantul-agape-atena.vercel.app/:path*",
      "permanent": true
    }
  ]
}